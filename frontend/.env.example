# Local dev: leave empty; Vite proxies /api to http://localhost:4000
VITE_API_URL=

# Railway single-service deploy: leave VITE_API_URL empty (or unset).
# The UI and API share the same origin, so requests use relative /api/... paths.

# Only set this if the API is on a different host (requires rebuild):
# VITE_API_URL=https://your-app.up.railway.app
